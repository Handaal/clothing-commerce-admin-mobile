# Public mobile configuration embedded into the app. None of these are secrets.
# Server secrets (Clerk secret key, service-role keys, webhook secrets) must NEVER use EXPO_PUBLIC_.

# Base URL of the Commerce API reachable by the device. Required — the app will not start without it
# and never falls back to mock or local data.
EXPO_PUBLIC_COMMERCE_API_URL=http://localhost:3000

# Clerk publishable key (public, safe to embed). Get it from the Clerk dashboard.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional local client-preview label. This replaces only the development fixture name "Dev Local"
# in presentation text; real tenant identity, authorization and API data are unchanged.
EXPO_PUBLIC_PREVIEW_STORE_NAME=
